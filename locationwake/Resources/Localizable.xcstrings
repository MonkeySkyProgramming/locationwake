    "位置情報を「常に許可」にし、通知を許可してください" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie den Standortzugriff auf „Immer erlauben“ ein und erlauben Sie Mitteilungen."
