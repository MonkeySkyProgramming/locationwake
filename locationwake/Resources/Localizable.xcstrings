          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта зона постоянно проверяет геолокацию и может увеличить расход батареи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
