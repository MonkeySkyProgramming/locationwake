    "ここでの変更は、これから作成するアラームにだけ反映されます。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki değişiklikler yalnızca bundan sonra oluşturacağınız alarmlara uygulanır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ किए गए बदलाव केवल आगे बनाए जाने वाले अलार्म पर लागू होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan di sini hanya berlaku untuk alarm yang Anda buat mulai sekarang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thay đổi ở đây chỉ áp dụng cho các báo thức bạn tạo từ bây giờ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงที่นี่จะมีผลกับการปลุกที่คุณสร้างจากนี้ไปเท่านั้น"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar här gäller bara alarm som du skapar framöver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的更改只会应用于今后创建的闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處的變更只會套用至之後建立的鬧鐘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 변경한 내용은 앞으로 만드는 알람에만 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen hier gelden alleen voor alarmen die je hierna maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany tutaj będą dotyczyć tylko alarmów utworzonych w przyszłości."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения здесь применяются только к будильникам, которые будут созданы в дальнейшем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни тут застосовуватимуться лише до будильників, створених надалі。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes here apply only to alarms you create from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios aquí solo se aplican a las alarmas que crees a partir de ahora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações feitas aqui serão aplicadas somente aos alarmes criados daqui em diante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications apportées ici s’appliquent uniquement aux alarmes créées à partir de maintenant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen hier gelten nur für Alarmen, die Sie künftig erstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche qui si applicano solo agli allarmi creati d’ora in poi."
          }
        }
      }
    },
