    "アラームが作動しないことがあります。%@設定にかかわらず監視は開始します。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Alarm wird möglicherweise nicht ausgelöst. Die Überwachung startet unabhängig von den %@-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The alarm may not go off. Monitoring will start regardless of %@ settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que la alarma no suene. El monitoreo comenzará independientemente de la configuración de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’alarme peut ne pas se déclencher. La surveillance démarrera indépendamment des réglages de %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलार्म काम न करे ऐसा हो सकता है। %@ सेटिंग के बावजूद निगरानी शुरू होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm mungkin tidak berfungsi. Pemantauan akan dimulai terlepas dari pengaturan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’allarme potrebbe non attivarsi. Il monitoraggio inizierà indipendentemente dalle impostazioni di %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알람이 작동하지 않을 수 있습니다. %@ 설정과 관계없이 모니터링을 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het alarm werkt mogelijk niet. Bewaking start ongeacht de %@-instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm może nie działać. Monitorowanie rozpocznie się niezależnie od ustawienia %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O alarme pode não disparar. O monitoramento será iniciado independentemente das configurações de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник может не сработать. Отслеживание начнётся независимо от настройки %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larmet kanske inte fungerar. Övervakningen startar oavsett inställningen %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปลุกอาจไม่ทำงาน การติดตามจะเริ่มโดยไม่ขึ้นกับการตั้งค่า %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm çalışmayabilir. İzleme, %@ ayarından bağımsız olarak başlatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник може не спрацювати. Відстеження почнеться незалежно від налаштування %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo thức có thể không hoạt động. Việc theo dõi sẽ bắt đầu bất kể cài đặt %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
