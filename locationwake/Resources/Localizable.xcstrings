          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปลุกจะแจ้งเตือนเมื่อคุณออกนอกขอบเขตปลายทางแล้วกลับเข้ามาอีกครั้ง"
