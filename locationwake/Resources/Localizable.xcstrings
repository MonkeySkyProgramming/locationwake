        "nl": { "stringUnit": { "state": "translated", "value": "Locatietoestemming is niet verleend" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Nie udzielono zezwolenia na lokalizację" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Разрешение на геолокацию не предоставлено" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Дозвіл на геолокацію не надано" } },
