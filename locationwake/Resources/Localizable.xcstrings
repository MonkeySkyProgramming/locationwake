    "位置情報を「常に許可」にしてください": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Konum erişimini “Her Zaman İzin Ver” olarak ayarlayın."}},"hi":{"stringUnit":{"state":"translated","value":"स्थान को “हमेशा अनुमति दें” पर सेट करें।"}},"id":{"stringUnit":{"state":"translated","value":"Atur lokasi ke “Selalu Izinkan”."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy đặt quyền vị trí thành “Luôn cho phép”."}},"th":{"stringUnit":{"state":"translated","value":"ตั้งค่าตำแหน่งเป็น “อนุญาตเสมอ”"}},"sv":{"stringUnit":{"state":"translated","value":"Ställ in platsåtkomst på ”Tillåt alltid”."}},
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请将位置权限设为“始终允许”" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請將位置權限設為「永遠允許」" } },
        "ko": { "stringUnit": { "state": "translated", "value": "위치 권한을 ‘항상 허용’으로 설정하세요" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Stel locatietoegang in op ‘Altijd toestaan’" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ustaw dostęp do lokalizacji na „Zawsze zezwalaj”" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Установите доступ к геолокации на «Разрешать всегда»" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Установіть доступ до геолокації на «Дозволяти завжди»" } },
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Set location access to “Always Allow”."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Configura el acceso a la ubicación en «Permitir siempre»."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Defina o acesso à localização como “Sempre Permitir”."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Réglez l’accès à la localisation sur « Toujours autoriser »."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Stellen Sie den Standortzugriff auf „Immer erlauben“ ein."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Imposta l’accesso alla posizione su “Consenti sempre”."
        }
      }
    }
  },
