    "位置情報は許可されていません": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Konum izni verilmedi."}},"hi":{"stringUnit":{"state":"translated","value":"स्थान अनुमति नहीं दी गई है।"}},"id":{"stringUnit":{"state":"translated","value":"Izin lokasi tidak diberikan."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa cấp quyền vị trí."}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้อนุญาตตำแหน่ง"}},"sv":{"stringUnit":{"state":"translated","value":"Platstillstånd har inte beviljats."}},
      "tr":{"stringUnit":{"state":"translated","value":"Konum izni verilmedi"}},"hi":{"stringUnit":{"state":"translated","value":"स्थान अनुमति नहीं दी गई है"}},"id":{"stringUnit":{"state":"translated","value":"Izin lokasi tidak diberikan"}},
