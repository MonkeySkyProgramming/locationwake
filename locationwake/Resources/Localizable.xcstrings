    "停止ボタンを押すまで、アラームの再生状態は終了しません。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm, Durdur düğmesine basana kadar çalmaya devam eder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकें बटन दबाने तक अलार्म बजता रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm akan terus berbunyi sampai Anda menekan tombol Hentikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo thức sẽ tiếp tục phát cho đến khi bạn nhấn nút Dừng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปลุกจะไม่สิ้นสุดจนกว่าคุณจะกดปุ่มหยุด"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmet fortsätter att spela tills du trycker på stoppknappen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm keeps playing until you press Stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La alarma seguirá sonando hasta que pulses Detener."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O alarme continua tocando até você pressionar Parar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alarme continue de sonner jusqu’à ce que vous appuyiez sur Arrêter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Alarm ertönt weiter, bis Sie auf „Stoppen“ tippen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’allarme continua a suonare finché non premi Ferma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按下停止按钮之前，闹钟播放不会结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在按下停止按鈕之前，鬧鐘播放不會結束。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지 버튼을 누를 때까지 알람 재생은 끝나지 않습니다。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het alarm blijft afspelen totdat je op de stopknop drukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm będzie odtwarzany, dopóki nie naciśniesz przycisku Zatrzymaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение будильника не завершится, пока вы не нажмёте кнопку остановки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення будильника не завершиться, доки ви не натиснете кнопку зупинки."
          }
        }
      }
    },
    "最大%lld件です。追加するには、不要なアラームを削除してください。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla %lld alarm ekleyebilirsiniz. Yeni eklemek için gereksiz alarmları silin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम %lld अलार्म की अनुमति है। नया जोड़ने के लिए अनावश्यक अलार्म हटाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum %lld alarm diizinkan. Hapus alarm yang tidak diperlukan untuk menambahkan yang baru."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa %lld báo thức. Hãy xóa các báo thức không cần thiết để thêm báo thức mới."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มการปลุกได้สูงสุด %lld รายการ ลบการปลุกที่ไม่จำเป็นเพื่อเพิ่มรายการใหม่"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ha högst %lld alarm. Ta bort onödiga alarm för att lägga till ett nytt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The limit is %lld. Delete unneeded alarms to add another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite es %lld. Elimina las alarmas que no necesites para añadir otra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite é %lld. Exclua alarmes desnecessários para adicionar outro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite est de %lld. Supprimez les alarmes inutiles pour en ajouter une autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit beträgt %lld. Löschen Sie nicht benötigte Alarme, um einen weiteren hinzuzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite è %lld. Elimina gli allarmi non necessari per aggiungerne un altro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多只能有 %lld 个。请删除不需要的闹钟以添加新的闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多只能有 %lld 個。請刪除不需要的鬧鐘以新增鬧鐘。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld개까지 가능합니다. 추가하려면 필요 없는 알람을 삭제해 주세요。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn maximaal %lld toegestaan. Verwijder onnodige alarmen om er een toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz mieć maksymalnie %lld alarmów. Usuń niepotrzebne alarmy, aby dodać kolejny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальное число — %lld. Чтобы добавить новый, удалите ненужные будильники."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальна кількість — %lld. Щоб додати новий, видаліть непотрібні будильники."
          }
        }
      }
    },
    "到着時に通知・音・バイブレーションでお知らせします。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vardığınızda bildirim, ses ve titreşimle haber veririz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँचने पर हम सूचना, ध्वनि और कंपन से आपको बताएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memberi tahu Anda saat tiba dengan notifikasi, suara, dan getaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ thông báo khi bạn đến bằng thông báo, âm thanh và rung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะแจ้งให้ทราบเมื่อถึงที่หมายด้วยการแจ้งเตือน เสียง และการสั่น"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du anländer meddelar vi dig med notiser, ljud och vibration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be notified by notification, sound, and vibration on arrival."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos con notificación, sonido y vibración al llegar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será avisado por notificação, som e vibração ao chegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez averti à l’arrivée par une notification, un son et une vibration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Ankunft werden Sie per Mitteilung, Ton und Vibration benachrichtigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’arrivo riceverai una notifica, un suono e una vibrazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达时将通过通知、声音和振动提醒您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達時會透過通知、聲音和震動提醒您。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착하면 알림, 소리, 진동으로 알려드립니다。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij aankomst krijg je een melding, geluid en trilling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dotarciu na miejsce powiadomimy Cię przez powiadomienie, dźwięk i wibracje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При прибытии вы получите уведомление со звуком и вибрацией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після прибуття ви отримаєте сповіщення зі звуком і вібрацією."
          }
        }
      }
    },
