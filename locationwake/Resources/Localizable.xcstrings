        "zh-Hans":{"stringUnit":{"state":"translated","value":"请检查位置和通知设置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請檢查位置和通知設定。"}},"ko":{"stringUnit":{"state":"translated","value":"위치 및 알림 설정을 확인하세요."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer de instellingen voor locatie en meldingen."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź ustawienia lokalizacji i powiadomień."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте настройки геолокации и уведомлений."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірте налаштування геолокації та сповіщень."}},
