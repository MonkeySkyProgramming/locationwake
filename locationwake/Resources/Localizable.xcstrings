{
  "sourceLanguage": "ja",
  "strings": {
    "「%@」に一致する場所はありません。検索語や地図の範囲を変えてください。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ile eşleşen yer yok. Arama terimini veya harita alanını değiştirin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” से मेल खाने वाली कोई जगह नहीं मिली। खोज शब्द या मानचित्र क्षेत्र बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tempat yang cocok dengan “%@”. Ubah istilah pencarian atau area peta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có địa điểm nào khớp với “%@”. Hãy thay đổi từ khóa tìm kiếm hoặc vùng bản đồ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสถานที่ที่ตรงกับ “%@” เปลี่ยนคำค้นหาหรือพื้นที่แผนที่"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga platser matchar “%@”. Ändra sökordet eller kartområdet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No places match “%@”. Change the search term or map area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay lugares que coincidan con “%@”. Cambia el término de búsqueda o el área del mapa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há locais que correspondam a “%@”. Altere o termo de busca ou a área do mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lieu ne correspond à « %@ ». Modifiez le terme de recherche ou la zone de la carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Orte entsprechen „%@“. Ändern Sie den Suchbegriff oder Kartenausschnitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun luogo corrisponde a “%@”. Modifica il termine di ricerca o l’area della mappa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与“%@”匹配的地点。请更改搜索词或地图范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有與「%@」相符的地點。請變更搜尋字詞或地圖範圍。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”와 일치하는 장소가 없습니다. 검색어나 지도 범위를 변경해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen plaatsen die overeenkomen met ‘%@’. Wijzig de zoekterm of het kaartgebied."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono miejsc pasujących do „%@”. Zmień wyszukiwane hasło lub obszar mapy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мест, соответствующих «%@», не найдено. Измените запрос или область карты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місць, що відповідають «%@», не знайдено. Змініть запит або область карти."
          }
        }
      }
    },
