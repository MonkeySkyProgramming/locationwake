    "到着時に通知・音・バイブレーションでお知らせします。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Ankunft werden Sie per Mitteilung, Ton und Vibration benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll be notified by notification, sound, and vibration on arrival."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos con notificación, sonido y vibración al llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez averti à l’arrivée par une notification, un son et une vibration."
