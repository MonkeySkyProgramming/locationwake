    "バイブレーションのみの場合、バックグラウンドでの繰り返し振動は保証されません。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei reiner Vibration sind wiederholte Vibrationen im Hintergrund nicht garantiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With vibration only, repeated vibration in the background is not guaranteed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con solo vibración, no se garantiza la vibración repetida en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la vibration seule, les vibrations répétées en arrière-plan ne sont pas garanties."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल कंपन होने पर, बैकग्राउंड में बार-बार कंपन की गारंटी नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat hanya getaran dipilih, getaran berulang di latar belakang tidak dijamin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sola vibrazione, non è garantita la ripetizione delle vibrazioni in background."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진동만 사용하는 경우 백그라운드에서 반복 진동이 보장되지 않습니다。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij alleen trillen is herhaald trillen op de achtergrond niet gegarandeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku samych wibracji powtarzające się wibracje w tle nie są gwarantowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com apenas vibração, a repetição da vibração em segundo plano não é garantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании только вибрации повторная вибрация в фоновом режиме не гарантируется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När endast vibration är valt kan upprepade vibrationer i bakgrunden inte garanteras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือกเฉพาะการสั่น ไม่รับประกันการสั่นซ้ำขณะทำงานเบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca titreşim seçildiğinde, arka planda tekrarlanan titreşim garanti edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У разі використання лише вібрації повторна вібрація у фоновому режимі не гарантується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
