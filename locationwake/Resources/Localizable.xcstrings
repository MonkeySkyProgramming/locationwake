      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Der bearbeitete Alarm wurde nicht gefunden. Er wurde möglicherweise gelöscht."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "L’allarme in modifica non è stato trovato. Potrebbe essere stato eliminato."
        }
      }
    }
  },
