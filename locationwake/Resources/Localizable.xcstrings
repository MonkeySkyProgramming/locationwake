    "スクリーンタイムまたは端末管理の制限により、このアプリから変更できません。端末の管理者またはスクリーンタイム設定を確認してください。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Süresi veya aygıt yönetimi kısıtlamaları nedeniyle bu uygulamadan değiştirilemez. Aygıt yöneticinize ya da Ekran Süresi ayarlarına bakın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन टाइम या डिवाइस प्रबंधन प्रतिबंधों के कारण इसे इस ऐप से बदला नहीं जा सकता। अपने डिवाइस व्यवस्थापक या स्क्रीन टाइम सेटिंग्स देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat diubah dari aplikasi ini karena pembatasan Durasi Layar atau pengelolaan perangkat. Periksa administrator perangkat atau pengaturan Durasi Layar Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi từ ứng dụng này do giới hạn Thời gian sử dụng hoặc quản lý thiết bị. Hãy kiểm tra quản trị viên thiết bị hoặc cài đặt Thời gian sử dụng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปลี่ยนจากแอปนี้ได้เนื่องจากข้อจำกัดเวลาหน้าจอหรือการจัดการอุปกรณ์ โปรดตรวจสอบผู้ดูแลอุปกรณ์หรือการตั้งค่าเวลาหน้าจอ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att ändra från den här appen på grund av begränsningar i Skärmtid eller enhetshantering. Kontrollera enhetsadministratören eller inställningarna för Skärmtid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be changed in this app because of Screen Time or device-management restrictions. Check with your device administrator or Screen Time settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar desde esta app debido a restricciones de Tiempo de uso o de gestión del dispositivo. Consulta al administrador del dispositivo o los ajustes de Tiempo de uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível alterar isso neste app devido a restrições de Tempo de Uso ou gerenciamento do dispositivo. Verifique com o administrador do dispositivo ou os ajustes de Tempo de Uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification est impossible dans cette app en raison de restrictions de Temps d’écran ou de gestion de l’appareil. Consultez l’administrateur de l’appareil ou les réglages de Temps d’écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann aufgrund von Bildschirmzeit- oder Geräteverwaltungsbeschränkungen nicht in dieser App geändert werden. Wenden Sie sich an Ihre Geräteadministration oder prüfen Sie die Bildschirmzeit-Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi modificare questa impostazione nell’app a causa di restrizioni di Tempo di utilizzo o gestione del dispositivo. Consulta l’amministratore del dispositivo o le impostazioni di Tempo di utilizzo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于屏幕使用时间或设备管理限制，无法在此应用中更改。请检查设备管理员或屏幕使用时间设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因螢幕使用時間或裝置管理限制，無法在此 App 中更改。請檢查裝置管理員或螢幕使用時間設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 또는 기기 관리 제한으로 인해 이 앱에서 변경할 수 없습니다. 기기 관리자 또는 스크린 타임 설정을 확인해 주세요。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet vanuit deze app worden gewijzigd vanwege beperkingen door Schermtijd of apparaatbeheer. Controleer de apparaatbeheerder of de instellingen voor Schermtijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można tego zmienić w tej aplikacji z powodu ograniczeń Czasu przed ekranem lub zarządzania urządzeniem. Sprawdź administratora urządzenia albo ustawienia Czasu przed ekranem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно изменить это в приложении из-за ограничений «Экранного времени» или управления устройством. Проверьте настройки администратора устройства или «Экранного времени»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо змінити це в програмі через обмеження «Екранного часу» або керування пристроєм. Перевірте налаштування адміністратора пристрою чи «Екранного часу»."
          }
        }
      }
    },
    "ダブルタップして設定を編集": {
      "localizations": {
