    }},
    "到着をお知らせするために": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"To notify you when you arrive"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为了在您到达时通知您"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為了在您抵達時通知您"}},"ko":{"stringUnit":{"state":"translated","value":"도착을 알려드리기 위해"}},"es":{"stringUnit":{"state":"translated","value":"Para avisarte al llegar"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Para avisar quando você chegar"}},"fr":{"stringUnit":{"state":"translated","value":"Pour vous prévenir à votre arrivée"}},"de":{"stringUnit":{"state":"translated","value":"Um Sie bei Ihrer Ankunft zu benachrichtigen"}},"it":{"stringUnit":{"state":"translated","value":"Per avvisarti al tuo arrivo"}},"nl":{"stringUnit":{"state":"translated","value":"Om je bij aankomst te melden"}},"pl":{"stringUnit":{"state":"translated","value":"Aby powiadomić Cię po przybyciu"}},"ru":{"stringUnit":{"state":"translated","value":"Чтобы уведомить вас о прибытии"}},"uk":{"stringUnit":{"state":"translated","value":"Щоб сповістити вас про прибуття"}},"tr":{"stringUnit":{"state":"translated","value":"Vardığınızda sizi bilgilendirmek için"}},"hi":{"stringUnit":{"state":"translated","value":"आपके पहुंचने पर सूचित करने के लिए"}},"id":{"stringUnit":{"state":"translated","value":"Untuk memberi tahu saat Anda tiba"}},"vi":{"stringUnit":{"state":"translated","value":"Để thông báo khi bạn đến nơi"}},"th":{"stringUnit":{"state":"translated","value":"เพื่อแจ้งเมื่อคุณมาถึง"}},"sv":{"stringUnit":{"state":"translated","value":"För att meddela dig när du kommer fram"}}
    }},
    "「常に許可」をリクエスト": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Request Always Allow"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求“始终允许”"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"要求「永遠允許」"}},"ko":{"stringUnit":{"state":"translated","value":"‘항상 허용’ 요청"}},"es":{"stringUnit":{"state":"translated","value":"Solicitar «Permitir siempre»"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Solicitar “Permitir Sempre”"}},"fr":{"stringUnit":{"state":"translated","value":"Demander « Toujours autoriser »"}},"de":{"stringUnit":{"state":"translated","value":"„Immer erlauben“ anfordern"}},"it":{"stringUnit":{"state":"translated","value":"Richiedi «Consenti sempre»"}},"nl":{"stringUnit":{"state":"translated","value":"‘Altijd toestaan’ aanvragen"}},"pl":{"stringUnit":{"state":"translated","value":"Poproś o „Zawsze zezwalaj”"}},"ru":{"stringUnit":{"state":"translated","value":"Запросить «Разрешать всегда»"}},"uk":{"stringUnit":{"state":"translated","value":"Запросити «Завжди дозволяти»"}},"tr":{"stringUnit":{"state":"translated","value":"“Her Zaman İzin Ver” iste"}},"hi":{"stringUnit":{"state":"translated","value":"‘हमेशा अनुमति दें’ का अनुरोध करें"}},"id":{"stringUnit":{"state":"translated","value":"Minta ‘Selalu Izinkan’"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu ‘Luôn cho phép’"}},"th":{"stringUnit":{"state":"translated","value":"ขอ ‘อนุญาตเสมอ’"}},"sv":{"stringUnit":{"state":"translated","value":"Begär ”Tillåt alltid”"}}
    }},
    "設定で「常に許可」にする": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Set to Always Allow in Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在设置中选择“始终允许”"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在設定中選擇「永遠允許」"}},"ko":{"stringUnit":{"state":"translated","value":"설정에서 ‘항상 허용’으로 변경"}},"es":{"stringUnit":{"state":"translated","value":"Elige «Permitir siempre» en Ajustes"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Defina como “Permitir Sempre” nos Ajustes"}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez « Toujours autoriser » dans Réglages"}},"de":{"stringUnit":{"state":"translated","value":"In Einstellungen „Immer erlauben“ wählen"}},"it":{"stringUnit":{"state":"translated","value":"Imposta «Consenti sempre» in Impostazioni"}},"nl":{"stringUnit":{"state":"translated","value":"Kies ‘Altijd toestaan’ in Instellingen"}},"pl":{"stringUnit":{"state":"translated","value":"Ustaw „Zawsze zezwalaj” w Ustawieniach"}},"ru":{"stringUnit":{"state":"translated","value":"Выберите «Разрешать всегда» в Настройках"}},"uk":{"stringUnit":{"state":"translated","value":"У Налаштуваннях виберіть «Завжди дозволяти»"}},"tr":{"stringUnit":{"state":"translated","value":"Ayarlar’dan “Her Zaman İzin Ver”i seçin"}},"hi":{"stringUnit":{"state":"translated","value":"सेटिंग्स में ‘हमेशा अनुमति दें’ चुनें"}},"id":{"stringUnit":{"state":"translated","value":"Atur ke ‘Selalu Izinkan’ di Pengaturan"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn ‘Luôn cho phép’ trong Cài đặt"}},"th":{"stringUnit":{"state":"translated","value":"ตั้งเป็น ‘อนุญาตเสมอ’ ในการตั้งค่า"}},"sv":{"stringUnit":{"state":"translated","value":"Välj ”Tillåt alltid” i Inställningar"}}
    }},
    "確認中…": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Checking…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在檢查…"}},"ko":{"stringUnit":{"state":"translated","value":"확인 중…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification…"}},"de":{"stringUnit":{"state":"translated","value":"Wird geprüft…"}},"it":{"stringUnit":{"state":"translated","value":"Verifica in corso…"}},"nl":{"stringUnit":{"state":"translated","value":"Controleren…"}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка…"}},"uk":{"stringUnit":{"state":"translated","value":"Перевірка…"}},"tr":{"stringUnit":{"state":"translated","value":"Kontrol ediliyor…"}},"hi":{"stringUnit":{"state":"translated","value":"जाँचा जा रहा है…"}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra…"}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบ…"}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar…"}}
    }},
    "通知を許可": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Allow notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许通知"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"允許通知"}},"ko":{"stringUnit":{"state":"translated","value":"알림 허용"}},"es":{"stringUnit":{"state":"translated","value":"Permitir notificaciones"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir notificações"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les notifications"}},"de":{"stringUnit":{"state":"translated","value":"Mitteilungen erlauben"}},"it":{"stringUnit":{"state":"translated","value":"Consenti notifiche"}},"nl":{"stringUnit":{"state":"translated","value":"Sta meldingen toe"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na powiadomienia"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить уведомления"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити сповіщення"}},"tr":{"stringUnit":{"state":"translated","value":"Bildirimlere izin ver"}},"hi":{"stringUnit":{"state":"translated","value":"सूचनाओं की अनुमति दें"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan notifikasi"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép thông báo"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตการแจ้งเตือน"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt notiser"}}
    }},
    "あとで設定する": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Set up later"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"稍后设置"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"稍後設定"}},"ko":{"stringUnit":{"state":"translated","value":"나중에 설정"}},"es":{"stringUnit":{"state":"translated","value":"Configurar más tarde"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configurar depois"}},"fr":{"stringUnit":{"state":"translated","value":"Configurer plus tard"}},"de":{"stringUnit":{"state":"translated","value":"Später einrichten"}},"it":{"stringUnit":{"state":"translated","value":"Configura più tardi"}},"nl":{"stringUnit":{"state":"translated","value":"Later instellen"}},"pl":{"stringUnit":{"state":"translated","value":"Skonfiguruj później"}},"ru":{"stringUnit":{"state":"translated","value":"Настроить позже"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштувати пізніше"}},"tr":{"stringUnit":{"state":"translated","value":"Daha sonra ayarla"}},"hi":{"stringUnit":{"state":"translated","value":"बाद में सेट करें"}},"id":{"stringUnit":{"state":"translated","value":"Atur nanti"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập sau"}},"th":{"stringUnit":{"state":"translated","value":"ตั้งค่าภายหลัง"}},"sv":{"stringUnit":{"state":"translated","value":"Ställ in senare"}}
    }},
    "位置情報を許可": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Allow location access"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许位置访问"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"允許取用位置資訊"}},"ko":{"stringUnit":{"state":"translated","value":"위치 접근 허용"}},"es":{"stringUnit":{"state":"translated","value":"Permitir acceso a la ubicación"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir acesso à localização"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès à la position"}},"de":{"stringUnit":{"state":"translated","value":"Standortzugriff erlauben"}},"it":{"stringUnit":{"state":"translated","value":"Consenti accesso alla posizione"}},"nl":{"stringUnit":{"state":"translated","value":"Locatietoegang toestaan"}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na dostęp do lokalizacji"}},"ru":{"stringUnit":{"state":"translated","value":"Разрешить доступ к геопозиции"}},"uk":{"stringUnit":{"state":"translated","value":"Дозволити доступ до геолокації"}},"tr":{"stringUnit":{"state":"translated","value":"Konum erişimine izin ver"}},"hi":{"stringUnit":{"state":"translated","value":"स्थान की अनुमति दें"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan akses lokasi"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép truy cập vị trí"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตการเข้าถึงตำแหน่ง"}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt platsåtkomst"}}
    }},
    "次へ": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Next"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一步"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下一步"}},"ko":{"stringUnit":{"state":"translated","value":"다음"}},"es":{"stringUnit":{"state":"translated","value":"Siguiente"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avançar"}},"fr":{"stringUnit":{"state":"translated","value":"Suivant"}},"de":{"stringUnit":{"state":"translated","value":"Weiter"}},"it":{"stringUnit":{"state":"translated","value":"Avanti"}},"nl":{"stringUnit":{"state":"translated","value":"Volgende"}},"pl":{"stringUnit":{"state":"translated","value":"Dalej"}},"ru":{"stringUnit":{"state":"translated","value":"Далее"}},"uk":{"stringUnit":{"state":"translated","value":"Далі"}},"tr":{"stringUnit":{"state":"translated","value":"İleri"}},"hi":{"stringUnit":{"state":"translated","value":"आगे"}},"id":{"stringUnit":{"state":"translated","value":"Berikutnya"}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp theo"}},"th":{"stringUnit":{"state":"translated","value":"ถัดไป"}},"sv":{"stringUnit":{"state":"translated","value":"Nästa"}}
    }},
    "通知の設定へ": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Set up notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置通知"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定通知"}},"ko":{"stringUnit":{"state":"translated","value":"알림 설정으로"}},"es":{"stringUnit":{"state":"translated","value":"Configurar notificaciones"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configurar notificações"}},"fr":{"stringUnit":{"state":"translated","value":"Configurer les notifications"}},"de":{"stringUnit":{"state":"translated","value":"Mitteilungen einrichten"}},"it":{"stringUnit":{"state":"translated","value":"Configura notifiche"}},"nl":{"stringUnit":{"state":"translated","value":"Meldingen instellen"}},"pl":{"stringUnit":{"state":"translated","value":"Skonfiguruj powiadomienia"}},"ru":{"stringUnit":{"state":"translated","value":"Настроить уведомления"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштувати сповіщення"}},"tr":{"stringUnit":{"state":"translated","value":"Bildirimleri ayarla"}},"hi":{"stringUnit":{"state":"translated","value":"सूचनाएं सेट करें"}},"id":{"stringUnit":{"state":"translated","value":"Atur notifikasi"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết lập thông báo"}},"th":{"stringUnit":{"state":"translated","value":"ตั้งค่าการแจ้งเตือน"}},"sv":{"stringUnit":{"state":"translated","value":"Ställ in notiser"}}
    }},
    "アプリを閉じている間も目的地への到着を検知するため、位置情報の「常に許可」が必要です。許可はあとから設定でも変更できます。": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"To detect arrival at your destination while the app is closed, location access must be set to Always Allow. You can change this later in Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为了在应用关闭时检测您到达目的地，需要将定位权限设为“始终允许”。您可以稍后在设置中更改。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為了在 App 關閉時偵測您抵達目的地，需要將定位權限設為「永遠允許」。您可以稍後在設定中變更。"}},"ko":{"stringUnit":{"state":"translated","value":"앱을 닫은 동안에도 목적지 도착을 감지하려면 위치 권한을 ‘항상 허용’으로 설정해야 합니다. 나중에 설정에서 변경할 수 있습니다."}},"es":{"stringUnit":{"state":"translated","value":"Para detectar tu llegada aunque la app esté cerrada, debes establecer la ubicación en «Permitir siempre». Puedes cambiarlo más tarde en Ajustes."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Para detectar sua chegada mesmo com o app fechado, a localização deve estar em “Permitir Sempre”. Você pode alterar isso depois nos Ajustes."}},"fr":{"stringUnit":{"state":"translated","value":"Pour détecter votre arrivée même lorsque l’app est fermée, l’accès à la position doit être réglé sur « Toujours autoriser ». Vous pourrez le modifier plus tard dans Réglages."}},"de":{"stringUnit":{"state":"translated","value":"Damit die Ankunft am Ziel auch bei geschlossener App erkannt wird, muss der Standortzugriff auf „Immer erlauben“ gesetzt sein. Dies kann später in Einstellungen geändert werden."}},"it":{"stringUnit":{"state":"translated","value":"Per rilevare l’arrivo alla destinazione anche quando l’app è chiusa, l’accesso alla posizione deve essere impostato su «Consenti sempre». Puoi cambiarlo più tardi in Impostazioni."}},"nl":{"stringUnit":{"state":"translated","value":"Om aankomst op je bestemming te detecteren terwijl de app gesloten is, moet locatietoegang op ‘Altijd toestaan’ staan. Je kunt dit later wijzigen in Instellingen."}},"pl":{"stringUnit":{"state":"translated","value":"Aby wykrywać przybycie do celu także po zamknięciu aplikacji, dostęp do lokalizacji musi być ustawiony na „Zawsze zezwalaj”. Możesz to później zmienić w Ustawieniach."}},"ru":{"stringUnit":{"state":"translated","value":"Чтобы определять прибытие к месту назначения, когда приложение закрыто, доступ к геопозиции должен быть установлен на «Разрешать всегда». Это можно изменить позже в Настройках."}},"uk":{"stringUnit":{"state":"translated","value":"Щоб визначати прибуття до пункту призначення, коли застосунок закрито, доступ до геолокації потрібно встановити на «Завжди дозволяти». Це можна змінити пізніше в Налаштуваннях."}},"tr":{"stringUnit":{"state":"translated","value":"Uygulama kapalıyken hedefe varışınızı algılamak için konum erişimi “Her Zaman İzin Ver” olarak ayarlanmalıdır. Bunu daha sonra Ayarlar’dan değiştirebilirsiniz."}},"hi":{"stringUnit":{"state":"translated","value":"ऐप बंद होने पर भी गंतव्य पर पहुंचने का पता लगाने के लिए स्थान अनुमति ‘हमेशा अनुमति दें’ पर होनी चाहिए। इसे बाद में सेटिंग्स में बदला जा सकता है।"}},"id":{"stringUnit":{"state":"translated","value":"Untuk mendeteksi kedatangan di tujuan saat aplikasi ditutup, akses lokasi harus diatur ke ‘Selalu Izinkan’. Anda dapat mengubahnya nanti di Pengaturan."}},"vi":{"stringUnit":{"state":"translated","value":"Để phát hiện bạn đến điểm đến khi ứng dụng đã đóng, quyền vị trí phải được đặt là ‘Luôn cho phép’. Bạn có thể thay đổi sau trong Cài đặt."}},"th":{"stringUnit":{"state":"translated","value":"เพื่อตรวจจับการมาถึงปลายทางแม้ปิดแอป ต้องตั้งสิทธิ์ตำแหน่งเป็น ‘อนุญาตเสมอ’ คุณเปลี่ยนได้ภายหลังในการตั้งค่า"}},"sv":{"stringUnit":{"state":"translated","value":"För att upptäcka när du kommer fram även när appen är stängd måste platsåtkomst vara inställd på ”Tillåt alltid”. Du kan ändra detta senare i Inställningar."}}
    }},
    "目的地に近づいたことを、通知・音・バイブレーションでお知らせします。通知はあとから設定でも変更できます。": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"We’ll notify you with a notification, sound, and vibration when you approach your destination. You can change notifications later in Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当您接近目的地时，我们会通过通知、声音和振动提醒您。您可以稍后在设置中更改通知。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"當您接近目的地時，我們會透過通知、聲音和震動提醒您。您可以稍後在設定中變更通知。"}},"ko":{"stringUnit":{"state":"translated","value":"목적지에 가까워지면 알림, 소리, 진동으로 알려드립니다. 알림은 나중에 설정에서 변경할 수 있습니다."}},"es":{"stringUnit":{"state":"translated","value":"Te avisaremos con una notificación, sonido y vibración cuando te acerques a tu destino. Puedes cambiar las notificaciones más tarde en Ajustes."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Vamos avisar por notificação, som e vibração quando você se aproximar do destino. Você pode alterar as notificações depois nos Ajustes."}},"fr":{"stringUnit":{"state":"translated","value":"Nous vous avertirons par notification, son et vibration lorsque vous approcherez de votre destination. Vous pourrez modifier les notifications plus tard dans Réglages."}},"de":{"stringUnit":{"state":"translated","value":"Wenn Sie sich Ihrem Ziel nähern, informieren wir Sie per Mitteilung, Ton und Vibration. Mitteilungen können später in Einstellungen geändert werden."}},"it":{"stringUnit":{"state":"translated","value":"Ti avviseremo con una notifica, un suono e una vibrazione quando ti avvicini alla destinazione. Puoi modificare le notifiche più tardi in Impostazioni."}},"nl":{"stringUnit":{"state":"translated","value":"We laten je met een melding, geluid en trilling weten wanneer je je bestemming nadert. Je kunt meldingen later wijzigen in Instellingen."}},"pl":{"stringUnit":{"state":"translated","value":"Gdy zbliżysz się do celu, powiadomimy Cię powiadomieniem, dźwiękiem i wibracją. Powiadomienia możesz później zmienić w Ustawieniach."}},"ru":{"stringUnit":{"state":"translated","value":"Когда вы приблизитесь к месту назначения, мы уведомим вас уведомлением, звуком и вибрацией. Уведомления можно изменить позже в Настройках."}},"uk":{"stringUnit":{"state":"translated","value":"Коли ви наблизитеся до пункту призначення, ми сповістимо вас сповіщенням, звуком і вібрацією. Сповіщення можна змінити пізніше в Налаштуваннях."}},"tr":{"stringUnit":{"state":"translated","value":"Hedefinize yaklaştığınızda bildirim, ses ve titreşimle size haber vereceğiz. Bildirimleri daha sonra Ayarlar’dan değiştirebilirsiniz."}},"hi":{"stringUnit":{"state":"translated","value":"गंतव्य के पास पहुंचने पर हम आपको सूचना, ध्वनि और कंपन से बताएंगे। सूचनाएं बाद में सेटिंग्स में बदली जा सकती हैं।"}},"id":{"stringUnit":{"state":"translated","value":"Kami akan memberi tahu Anda dengan notifikasi, suara, dan getaran saat mendekati tujuan. Notifikasi dapat diubah nanti di Pengaturan."}},"vi":{"stringUnit":{"state":"translated","value":"Chúng tôi sẽ thông báo bằng thông báo, âm thanh và rung khi bạn đến gần điểm đến. Bạn có thể thay đổi thông báo sau trong Cài đặt."}},"th":{"stringUnit":{"state":"translated","value":"เราจะแจ้งเตือนด้วยการแจ้งเตือน เสียง และการสั่นเมื่อคุณเข้าใกล้ปลายทาง คุณเปลี่ยนการแจ้งเตือนได้ภายหลังในการตั้งค่า"}},"sv":{"stringUnit":{"state":"translated","value":"Vi meddelar dig med en notis, ett ljud och vibration när du närmar dig din destination. Du kan ändra notiser senare i Inställningar."}}
    }},
    "同時に監視できる到着範囲の上限に達しています。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Aynı anda izlenebilecek varış alanı sınırına ulaşıldı."}},"hi":{"stringUnit":{"state":"translated","value":"एक साथ निगरानी किए जा सकने वाले आगमन क्षेत्रों की सीमा पहुँच गई है।"}},"id":{"stringUnit":{"state":"translated","value":"Batas area kedatangan yang dapat dipantau bersamaan telah tercapai."}},
      "vi":{"stringUnit":{"state":"translated","value":"Đã đạt giới hạn số vùng đến có thể theo dõi cùng lúc."}},"th":{"stringUnit":{"state":"translated","value":"ถึงขีดจำกัดของพื้นที่เมื่อถึงที่ติดตามพร้อมกันได้แล้ว"}},"sv":{"stringUnit":{"state":"translated","value":"Gränsen för antal ankomstområden som kan övervakas samtidigt har nåtts."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"已达到同时监控到达范围的上限。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已達到同時監控抵達範圍的上限。"}},"ko":{"stringUnit":{"state":"translated","value":"동시에 모니터링할 수 있는 도착 범위 한도에 도달했습니다."}},"nl":{"stringUnit":{"state":"translated","value":"De limiet voor gelijktijdige aankomstgebieden is bereikt."}},"pl":{"stringUnit":{"state":"translated","value":"Osiągnięto limit jednocześnie monitorowanych obszarów przybycia."}},"ru":{"stringUnit":{"state":"translated","value":"Достигнут лимит одновременно отслеживаемых зон прибытия."}},"uk":{"stringUnit":{"state":"translated","value":"Досягнуто ліміту одночасно відстежуваних зон прибуття."}},
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The maximum number of arrival areas that can be monitored at once has been reached."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se alcanzó el número máximo de áreas de llegada que se pueden monitorear a la vez."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Foi atingido o limite de áreas de chegada que podem ser monitoradas ao mesmo tempo."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le nombre maximal de zones d’arrivée pouvant être surveillées simultanément est atteint."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Die maximale Anzahl gleichzeitig überwachbarer Ankunftsbereiche wurde erreicht."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "È stato raggiunto il numero massimo di aree di arrivo monitorabili contemporaneamente."
        }
      }
    }
  },
    "到着範囲を監視するには位置情報の許可が必要です。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Varış alanını izlemek için konum izni gereklidir."}},"hi":{"stringUnit":{"state":"translated","value":"आगमन क्षेत्र की निगरानी के लिए स्थान अनुमति आवश्यक है।"}},"id":{"stringUnit":{"state":"translated","value":"Izin lokasi diperlukan untuk memantau area kedatangan."}},"vi":{"stringUnit":{"state":"translated","value":"Cần cấp quyền vị trí để theo dõi vùng đến."}},"th":{"stringUnit":{"state":"translated","value":"ต้องอนุญาตตำแหน่งเพื่อติดตามพื้นที่เมื่อถึง"}},"sv":{"stringUnit":{"state":"translated","value":"Platstillstånd krävs för att övervaka ankomstområdet."}},
      "tr":{"stringUnit":{"state":"translated","value":"Varış alanını izlemek için konum izni gerekir."}},"hi":{"stringUnit":{"state":"translated","value":"आगमन क्षेत्र की निगरानी के लिए स्थान अनुमति आवश्यक है।"}},"id":{"stringUnit":{"state":"translated","value":"Izin lokasi diperlukan untuk memantau area kedatangan."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"监控到达范围需要位置权限。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"監控抵達範圍需要位置權限。"}},"ko":{"stringUnit":{"state":"translated","value":"도착 범위를 모니터링하려면 위치 권한이 필요합니다."}},"nl":{"stringUnit":{"state":"translated","value":"Locatietoestemming is vereist om het aankomstgebied te bewaken."}},"pl":{"stringUnit":{"state":"translated","value":"Do monitorowania obszaru przybycia wymagane jest zezwolenie na lokalizację."}},"ru":{"stringUnit":{"state":"translated","value":"Для отслеживания зоны прибытия требуется разрешение на геолокацию."}},"uk":{"stringUnit":{"state":"translated","value":"Для відстеження зони прибуття потрібен дозвіл на геолокацію."}},
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Location permission is required to monitor the arrival area."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se necesita permiso de ubicación para monitorear el área de llegada."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "É necessária permissão de localização para monitorar a área de chegada."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’autorisation de localisation est requise pour surveiller la zone d’arrivée."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Für die Überwachung des Ankunftsbereichs ist eine Standortfreigabe erforderlich."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Per monitorare l’area di arrivo è necessaria l’autorizzazione alla posizione."
        }
      }
    }
  },
    "到着範囲の監視を開始できませんでした。設定を確認して再度お試しください。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Varış alanı izleme başlatılamadı. Ayarları kontrol edip yeniden deneyin."}},"hi":{"stringUnit":{"state":"translated","value":"आगमन क्षेत्र निगरानी शुरू नहीं हो सकी। सेटिंग जाँचकर पुनः प्रयास करें।"}},"id":{"stringUnit":{"state":"translated","value":"Pemantauan area kedatangan tidak dapat dimulai. Periksa pengaturan lalu coba lagi."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể bắt đầu theo dõi vùng đến. Hãy kiểm tra cài đặt và thử lại."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเริ่มติดตามพื้นที่เมื่อถึงได้ โปรดตรวจสอบการตั้งค่าแล้วลองอีกครั้ง"}},"sv":{"stringUnit":{"state":"translated","value":"Kunde inte starta övervakning av ankomstområdet. Kontrollera inställningarna och försök igen."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"无法开始监控到达范围。请检查设置后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法開始監控抵達範圍。請檢查設定後重試。"}},"ko":{"stringUnit":{"state":"translated","value":"도착 범위 모니터링을 시작할 수 없습니다. 설정을 확인하고 다시 시도하세요."}},"nl":{"stringUnit":{"state":"translated","value":"Kan aankomstgebied niet bewaken. Controleer de instellingen en probeer opnieuw."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można rozpocząć monitorowania obszaru. Sprawdź ustawienia i spróbuj ponownie."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось начать отслеживание. Проверьте настройки и повторите попытку."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося почати відстеження. Перевірте налаштування та спробуйте ще раз."}},
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Could not start monitoring the arrival area. Check your settings and try again."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "No se pudo iniciar el monitoreo del área de llegada. Revisa la configuración e inténtalo de nuevo."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Não foi possível iniciar o monitoramento da área de chegada. Verifique as configurações e tente novamente."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Impossible de démarrer la surveillance de la zone d’arrivée. Vérifiez vos réglages et réessayez."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Die Überwachung des Ankunftsbereichs konnte nicht gestartet werden. Prüfen Sie die Einstellungen und versuchen Sie es erneut."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Impossibile avviare il monitoraggio dell’area di arrivo. Controlla le impostazioni e riprova."
        }
      }
    }
  },
