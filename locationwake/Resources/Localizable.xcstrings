    "目的地で、確実に起きる。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefte, emin bir şekilde uyanın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंतव्य पर, निश्चित रूप से जागें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun dengan pasti di tujuan Anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thức dậy chắc chắn tại điểm đến."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตื่นให้แน่นอนเมื่อถึงปลายทาง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakna säkert vid destinationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake up reliably at your destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despierta con seguridad en tu destino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorde com segurança no seu destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveillez-vous à coup sûr à destination."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ziel zuverlässig aufwachen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svegliati in modo affidabile a destinazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目的地，可靠地醒来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在目的地，可靠地醒來。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적지에서, 확실하게 일어나세요。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Word zeker wakker op je bestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obudź się pewnie w miejscu docelowym."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Надёжно просыпайтесь в пункте назначения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надійно прокидайтеся в пункті призначення。"
          }
        }
      }
    },
    "目的地に近づいたら、通知・音・バイブレーションでお知らせします。": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefe yaklaştığınızda bildirim, ses ve titreşimle sizi haberdar ederiz."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप गंतव्य के पास पहुँचेंगे, हम सूचना, ध्वनि और कंपन से आपको बताएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda mendekati tujuan, kami akan memberi tahu melalui notifikasi, suara, dan getaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đến gần điểm đến, chúng tôi sẽ thông báo bằng thông báo, âm thanh và rung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณเข้าใกล้ปลายทาง เราจะแจ้งให้ทราบด้วยการแจ้งเตือน เสียง และการสั่น"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du närmar dig destinationen meddelar vi dig med notiser, ljud och vibrationer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you approach your destination, you’ll be notified by notification, sound, and vibration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te acerques a tu destino, te avisaremos con notificación, sonido y vibración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você se aproximar do destino, será avisado por notificação, som e vibração."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous approcherez de votre destination, vous serez averti par notification, son et vibration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie sich Ihrem Ziel nähern, werden Sie per Mitteilung, Ton und Vibration benachrichtigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti avvicini alla destinazione, riceverai una notifica, un suono e una vibrazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近目的地时，将通过通知、声音和振动提醒您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
