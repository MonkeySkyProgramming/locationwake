    "%@に到着しました。アプリを開き、停止ボタンで止めてください。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"%@ konumuna ulaştınız. Uygulamayı açın ve Durdur düğmesiyle kapatın."}},"hi":{"stringUnit":{"state":"translated","value":"आप %@ पर पहुँच गए हैं। ऐप खोलें और रोकें बटन दबाकर बंद करें।"}},"id":{"stringUnit":{"state":"translated","value":"Anda telah tiba di %@. Buka app dan hentikan dengan tombol Berhenti."}},"vi":{"stringUnit":{"state":"translated","value":"Bạn đã đến %@. Mở ứng dụng và dừng bằng nút Dừng."}},"th":{"stringUnit":{"state":"translated","value":"คุณมาถึง %@ แล้ว เปิดแอปแล้วหยุดด้วยปุ่มหยุด"}},"sv":{"stringUnit":{"state":"translated","value":"Du har kommit fram till %@. Öppna appen och stoppa med knappen Stoppa."}},
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "您已到达%@。请打开 App 并使用停止按钮关闭闹钟。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "您已抵達%@。請開啟 App 並使用停止按鈕關閉鬧鐘。" } }, "ko": { "stringUnit": { "state": "translated", "value": "%@에 도착했습니다. 앱을 열고 정지 버튼으로 알람을 끄세요." } }, "nl": { "stringUnit": { "state": "translated", "value": "U bent aangekomen bij %@. Open de app en stop het alarm met de stopknop." } }, "pl": { "stringUnit": { "state": "translated", "value": "Dotarłeś(-aś) do %@. Otwórz aplikację i zatrzymaj alarm przyciskiem stop." } }, "ru": { "stringUnit": { "state": "translated", "value": "Вы прибыли в %@. Откройте приложение и остановите будильник кнопкой остановки." } }, "uk": { "stringUnit": { "state": "translated", "value": "Ви прибули до %@. Відкрийте застосунок і зупиніть будильник кнопкою зупинки." } },
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "You arrived at %@. Open the app and tap Stop to turn off the alarm."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Has llegado a %@. Abre la app y toca Detener para apagar la alarma."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Você chegou a %@. Abra o app e toque em Parar para desligar o alarme."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Vous êtes arrivé à %@. Ouvrez l’app et touchez Arrêter pour couper l’alarme."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Sie sind bei %@ angekommen. Öffnen Sie die App und tippen Sie auf „Stoppen“, um den Alarm auszuschalten."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Sei arrivato a %@. Apri l’app e tocca Interrompi per spegnere l’allarme."
        }
      }
    }
  },
    "%@への到着を記録しました。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"%@ varışı kaydedildi."}},"hi":{"stringUnit":{"state":"translated","value":"%@ पर आगमन दर्ज किया गया।"}},"id":{"stringUnit":{"state":"translated","value":"Kedatangan di %@ telah dicatat."}},"vi":{"stringUnit":{"state":"translated","value":"Đã ghi nhận việc đến %@."}},"th":{"stringUnit":{"state":"translated","value":"บันทึกการมาถึง %@ แล้ว"}},"sv":{"stringUnit":{"state":"translated","value":"Ankomst till %@ har registrerats."}},
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已记录到达%@。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "已記錄抵達%@。" } }, "ko": { "stringUnit": { "state": "translated", "value": "%@ 도착을 기록했습니다." } }, "nl": { "stringUnit": { "state": "translated", "value": "Aankomst bij %@ is vastgelegd." } }, "pl": { "stringUnit": { "state": "translated", "value": "Zarejestrowano przybycie do %@." } }, "ru": { "stringUnit": { "state": "translated", "value": "Прибытие в %@ зарегистрировано." } }, "uk": { "stringUnit": { "state": "translated", "value": "Прибуття до %@ зареєстровано." } },
