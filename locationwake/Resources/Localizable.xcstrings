        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm akan memberi tahu Anda setelah Anda keluar dari area tujuan lalu masuk kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’allarme ti avvisa quando esci dall’area di destinazione e vi rientri."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목적지 범위를 벗어났다가 다시 들어오면 알람으로 알려드립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het alarm meldt het wanneer je het bestemmingsgebied verlaat en opnieuw binnenkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm powiadomi, gdy opuścisz obszar celu i ponownie do niego wejdziesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
