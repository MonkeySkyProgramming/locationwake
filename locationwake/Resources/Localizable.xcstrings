          "state": "translated",
          "value": "The alarm being edited could not be found. It may have been deleted."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "No se encontró la alarma que estás editando. Es posible que se haya eliminado."
