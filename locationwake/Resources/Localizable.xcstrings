    "次回の到着時に一度だけお知らせします。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Bir sonraki varışta yalnızca bir kez bildirim gönderir."}},"hi":{"stringUnit":{"state":"translated","value":"अगली बार पहुँचने पर केवल एक बार सूचित करेगा।"}},"id":{"stringUnit":{"state":"translated","value":"Memberi tahu sekali saja saat kedatangan berikutnya."}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ thông báo một lần khi bạn đến nơi lần tới."}},"th":{"stringUnit":{"state":"translated","value":"จะแจ้งเตือนเพียงครั้งเดียวเมื่อมาถึงครั้งถัดไป"}},"sv":{"stringUnit":{"state":"translated","value":"Meddelar bara en gång vid nästa ankomst."}},
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "将在下次到达时仅通知一次。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "將在下次抵達時只通知一次。" } }, "ko": { "stringUnit": { "state": "translated", "value": "다음 도착 시 한 번만 알려드립니다." } }, "nl": { "stringUnit": { "state": "translated", "value": "U krijgt slechts één melding bij de volgende aankomst." } }, "pl": { "stringUnit": { "state": "translated", "value": "Otrzymasz powiadomienie tylko raz przy następnym przybyciu." } }, "ru": { "stringUnit": { "state": "translated", "value": "При следующем прибытии вы получите уведомление только один раз." } }, "uk": { "stringUnit": { "state": "translated", "value": "Під час наступного прибуття ви отримаєте сповіщення лише один раз." } },
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "You’ll be notified once at your next arrival."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Recibirás una notificación una sola vez cuando llegues la próxima vez."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Você receberá uma notificação uma vez na próxima chegada."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Vous recevrez une notification une seule fois lors de votre prochaine arrivée."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
