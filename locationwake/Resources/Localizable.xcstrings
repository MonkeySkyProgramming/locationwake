    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Bu varış alanı sürekli konum kontrolü kullanır; pil tüketimi artabilir."}},"hi":{"stringUnit":{"state":"translated","value":"यह आगमन क्षेत्र लगातार स्थान जाँच का उपयोग करता है, जिससे बैटरी खपत बढ़ सकती है।"}},"id":{"stringUnit":{"state":"translated","value":"Area kedatangan ini menggunakan pemeriksaan lokasi berkelanjutan sehingga konsumsi baterai dapat meningkat."}},"vi":{"stringUnit":{"state":"translated","value":"Vùng đến này dùng kiểm tra vị trí liên tục nên có thể tăng mức tiêu thụ pin."}},"th":{"stringUnit":{"state":"translated","value":"พื้นที่เมื่อถึงนี้ใช้การตรวจสอบตำแหน่งต่อเนื่อง จึงอาจใช้แบตเตอรี่มากขึ้น"}},"sv":{"stringUnit":{"state":"translated","value":"Detta ankomstområde använder kontinuerlig platskontroll, vilket kan öka batteriförbrukningen."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"此到达范围会持续检查当前位置，可能增加耗电。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此抵達範圍會持續檢查目前位置，可能增加耗電。"}},"ko":{"stringUnit":{"state":"translated","value":"이 도착 범위는 현재 위치를 계속 확인하므로 배터리 소모가 늘 수 있습니다."}},"nl":{"stringUnit":{"state":"translated","value":"Dit aankomstgebied controleert uw locatie voortdurend en kan meer batterij verbruiken."}},"pl":{"stringUnit":{"state":"translated","value":"Ten obszar stale sprawdza lokalizację i może zwiększyć zużycie baterii."}},"ru":{"stringUnit":{"state":"translated","value":"Эта зона постоянно проверяет геолокацию и может увеличить расход батареи."}},"uk":{"stringUnit":{"state":"translated","value":"Ця зона постійно перевіряє геолокацію та може збільшити витрату заряду."}},
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This arrival area uses continuous location checks and may use more battery."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Esta área de llegada usa comprobaciones continuas de ubicación y puede consumir más batería."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Esta área de chegada usa verificações contínuas de localização e pode consumir mais bateria."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Cette zone d’arrivée utilise une vérification continue de la position et peut consommer davantage de batterie."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Dieser Ankunftsbereich verwendet fortlaufende Standortprüfungen und kann mehr Akku verbrauchen."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Questa area di arrivo usa controlli continui della posizione e può consumare più batteria."
        }
      }
    }
  },
    "%lld mを超えるため、現在地の継続確認を使います。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"%lld m aştığı için sürekli konum kontrolü kullanılır."}},"hi":{"stringUnit":{"state":"translated","value":"%lld मी से अधिक होने के कारण लगातार स्थान जाँच का उपयोग किया जाएगा।"}},"id":{"stringUnit":{"state":"translated","value":"Karena melebihi %lld m, pemeriksaan lokasi berkelanjutan akan digunakan."}},"vi":{"stringUnit":{"state":"translated","value":"Vì vượt quá %lld m, ứng dụng sẽ dùng kiểm tra vị trí liên tục."}},"th":{"stringUnit":{"state":"translated","value":"เนื่องจากเกิน %lld ม. จึงจะใช้การตรวจสอบตำแหน่งต่อเนื่อง"}},"sv":{"stringUnit":{"state":"translated","value":"Eftersom det överstiger %lld m används kontinuerlig platskontroll."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"由于超过 %lld 米，将持续检查当前位置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"因超過 %lld 公尺，將持續檢查目前位置。"}},"ko":{"stringUnit":{"state":"translated","value":"%lldm를 초과하므로 현재 위치를 계속 확인합니다."}},"nl":{"stringUnit":{"state":"translated","value":"Omdat het meer dan %lld m is, wordt uw locatie voortdurend gecontroleerd."}},"pl":{"stringUnit":{"state":"translated","value":"Ponieważ przekracza %lld m, lokalizacja będzie sprawdzana stale."}},"ru":{"stringUnit":{"state":"translated","value":"Поскольку это более %lld м, геолокация будет проверяться постоянно."}},"uk":{"stringUnit":{"state":"translated","value":"Оскільки це понад %lld м, геолокація перевірятиметься постійно."}},
        "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Because it exceeds %lld m, continuous location checks will be used."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Como supera los %lld m, se usarán comprobaciones continuas de ubicación."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Como excede %lld m, serão usadas verificações contínuas de localização."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Comme cela dépasse %lld m, une vérification continue de la position sera utilisée."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Da es %lld m überschreitet, werden fortlaufende Standortprüfungen verwendet."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Poiché supera %lld m, verranno usati controlli continui della posizione."
        }
      }
    }
  },
