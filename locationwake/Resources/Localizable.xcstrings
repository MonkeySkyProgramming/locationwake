    "保存したアラームを読み込めませんでした。": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Kaydedilen alarmlar yüklenemedi."}},"hi":{"stringUnit":{"state":"translated","value":"सहेजे गए अलार्म लोड नहीं किए जा सके।"}},"id":{"stringUnit":{"state":"translated","value":"Alarm yang disimpan tidak dapat dimuat."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải báo thức đã lưu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดการปลุกที่บันทึกไว้ได้"}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att läsa in sparade larm."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载已保存的闹钟。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法載入已儲存的鬧鐘。"}},"ko":{"stringUnit":{"state":"translated","value":"저장된 알람을 불러올 수 없습니다."}},"nl":{"stringUnit":{"state":"translated","value":"Opgeslagen alarmen kunnen niet worden geladen."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można wczytać zapisanych alarmów."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить сохранённые будильники."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити збережені будильники."}},
        "en": {
