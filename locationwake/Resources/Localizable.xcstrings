    "この端末では位置情報が制限されています": {
    "localizations": {
      "tr":{"stringUnit":{"state":"translated","value":"Konum bu cihazda kısıtlanmıştır."}},"hi":{"stringUnit":{"state":"translated","value":"इस डिवाइस पर स्थान सेवा प्रतिबंधित है।"}},"id":{"stringUnit":{"state":"translated","value":"Lokasi dibatasi di perangkat ini."}},"vi":{"stringUnit":{"state":"translated","value":"Vị trí bị hạn chế trên thiết bị này."}},"th":{"stringUnit":{"state":"translated","value":"ตำแหน่งถูกจำกัดบนอุปกรณ์นี้"}},"sv":{"stringUnit":{"state":"translated","value":"Platsinformation är begränsad på den här enheten."}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"此设备的位置服务受限"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此裝置的位置服務受到限制"}},"ko":{"stringUnit":{"state":"translated","value":"이 기기에서는 위치 서비스가 제한되어 있습니다"}},"nl":{"stringUnit":{"state":"translated","value":"Locatievoorzieningen zijn beperkt op dit apparaat"}},"pl":{"stringUnit":{"state":"translated","value":"Usługi lokalizacji są ograniczone na tym urządzeniu"}},"ru":{"stringUnit":{"state":"translated","value":"Службы геолокации ограничены на этом устройстве"}},"uk":{"stringUnit":{"state":"translated","value":"Служби геолокації обмежені на цьому пристрої"}},
        "en": {
