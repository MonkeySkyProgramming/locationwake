      "tr":{"stringUnit":{"state":"translated","value":"Şu anda “Uygulamayı Kullanırken” seçili"}},"hi":{"stringUnit":{"state":"translated","value":"वर्तमान में “ऐप इस्तेमाल करते समय” है"}},"id":{"stringUnit":{"state":"translated","value":"Saat ini “Saat Menggunakan App”"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện tại là “Khi dùng ứng dụng”"}},"th":{"stringUnit":{"state":"translated","value":"ขณะนี้เป็น “ขณะใช้แอป”"}},"sv":{"stringUnit":{"state":"translated","value":"Just nu: ”När appen används”"}},
        "zh-Hans":{"stringUnit":{"state":"translated","value":"当前为“使用 App 期间”"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前為「使用 App 期間」"}},"ko":{"stringUnit":{"state":"translated","value":"현재 ‘앱을 사용하는 동안’입니다"}},"nl":{"stringUnit":{"state":"translated","value":"Momenteel: ‘Tijdens gebruik van de app’"}},"pl":{"stringUnit":{"state":"translated","value":"Obecnie: „Podczas używania aplikacji”"}},"ru":{"stringUnit":{"state":"translated","value":"Сейчас: «При использовании приложения»"}},"uk":{"stringUnit":{"state":"translated","value":"Зараз: «Під час використання застосунку»"}},
        "en": {
